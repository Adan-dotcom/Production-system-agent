DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/biotecnica_mvp
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Printing architecture: browser_preview (recommended for USB Zebra ZD421)
# The station PC opens a label preview tab and prints via the local USB printer.
# No network/IP printer configuration required.
PRINT_BACKEND=browser_preview

# Ruta fija al Excel exportado por Aspel SAE (para sincronización automática en producción).
# Déjala vacía para usar sólo upload manual.
# Ejemplo planta: ASPEL_EXCEL_PATH=C:\Aspel\Reportes\Pedidos.xlsx
ASPEL_EXCEL_PATH=

# Intervalo entre sincronizaciones automáticas (en minutos). Por defecto: 30.
# Solo aplica si ASPEL_EXCEL_PATH está configurada.
ASPEL_SYNC_INTERVAL_MINUTES=30

# ── Monitor de máquinas (sensor Hall → ESP32 → MQTT) ──────────────────────────
# Deja MQTT_BROKER_HOST vacío para deshabilitar el monitor (el server arranca igual).
# Apunta al broker Mosquitto (normalmente el mismo server: localhost).
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=biotecnica/maquinas
# Segundos sin mensaje del ESP antes de marcar la máquina "sin señal" (ESP/red caída).
# El ESP publica cada 1s; 6s tolera varios paquetes perdidos sin parpadeo falso.
MACHINE_STALE_SECONDS=6
